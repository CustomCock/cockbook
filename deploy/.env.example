# Kopieren nach deploy/.env und ausfüllen. deploy/.env wird NIE committet (.gitignore).

# Deine Adresse, z. B. von duckdns.org (kostenlos): meincockbook.duckdns.org
COCKBOOK_DOMAIN=meincockbook.duckdns.org

# Zugangs-Token, mindestens 24 Zeichen. Erzeugen mit:  openssl rand -hex 24
COCKBOOK_TOKEN=hier-ein-langes-zufaelliges-token-eintragen

# Speichergrenze fürs Backend (1-GB-VM: 700m, größere VM: z. B. 2g)
COCKBOOK_MEM_LIMIT=700m
