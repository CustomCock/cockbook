{
  "manifest_version": "0.3",
  "name": "cockbook",
  "display_name": "CockBook",
  "version": "0.1.0",
  "description": "Liest Orderbuch, Trade-Flow, Kerzen und Konten aus deinem lokal laufenden CockBook und zeichnet in den Chart.",
  "long_description": "Verbindet Claude mit dem lokal laufenden CockBook-Backend (ws://127.0.0.1:8765). Lesend: Symbole, Orderbuch-Zusammenfassung (Wände, Ungleichgewicht), Trade-Flow (Delta, große Trades), Kerzen, Kennzahlen, Paper- und Live-Konto. Schreibend: Zeichnungen im Chart (markiert als 'von Claude') und Paper-Orders (simuliert, jede mit Bestätigung). Echte Orders sind bewusst nicht möglich. Keine Anlageberatung.",
  "author": { "name": "CustomCock" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/CustomCock/cockbook" },
  "server": {
    "type": "python",
    "entry_point": "launcher.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${user_config.cockbook_dir}${/}backend",
        "python",
        "-m",
        "cockbook.mcp_server"
      ],
      "env": {
        "COCKBOOK_URL": "${user_config.url}",
        "COCKBOOK_TOKEN": "${user_config.token}"
      }
    }
  },
  "tools": [
    { "name": "list_symbols", "description": "Symbole mit Orderbuch, Bid/Ask" },
    { "name": "get_orderbook", "description": "Orderbuch-Zusammenfassung: Wände, Summen, Ungleichgewicht" },
    { "name": "get_trade_flow", "description": "Kauf-/Verkaufsvolumen, Delta, größte Trades" },
    { "name": "get_candles", "description": "OHLCV-Kerzen" },
    { "name": "get_market_stats", "description": "24h, Funding, Open Interest" },
    { "name": "get_paper_account", "description": "Paper-Konto" },
    { "name": "get_live_account", "description": "Echtes Konto, nur lesend" },
    { "name": "list_drawing_tools", "description": "Zeichenwerkzeuge" },
    { "name": "list_drawings", "description": "Zeichnungen eines Coins" },
    { "name": "add_drawing", "description": "Zeichnung setzen" },
    { "name": "update_drawing", "description": "Zeichnung ändern" },
    { "name": "remove_drawing", "description": "Zeichnung löschen" },
    { "name": "clear_drawings", "description": "Zeichnungen löschen (Standard: nur Claudes)" },
    { "name": "place_paper_order", "description": "Paper-Order (simuliert, mit Bestätigung)" },
    { "name": "close_paper_position", "description": "Paper-Position schließen" },
    { "name": "cancel_paper_orders", "description": "Paper-Orders löschen" }
  ],
  "user_config": {
    "cockbook_dir": {
      "type": "directory",
      "title": "CockBook-Ordner",
      "description": "Der geklonte cockbook-Ordner (enthält backend/ und frontend/)",
      "required": true
    },
    "url": {
      "type": "string",
      "title": "Backend-Adresse",
      "description": "WebSocket der CockBook-Bridge",
      "default": "ws://127.0.0.1:8765/ws",
      "required": false
    },
    "token": {
      "type": "string",
      "title": "Token (nur Server-Betrieb)",
      "description": "COCKBOOK_TOKEN, nur nötig wenn das Backend mit COCKBOOK_PUBLIC=1 läuft",
      "sensitive": true,
      "default": "",
      "required": false
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": { "python": ">=3.12" }
  }
}
